from collections import deque

class Graph:
    def __init__(self):
        # Adjacency list representation
        self.adj_list = {}

    def add_edge(self, u, v):
        if u not in self.adj_list:
            self.adj_list[u] = []
        if v not in self.adj_list:
            self.adj_list[v] = []
        # Undirected graph (remove the second line for a directed graph)
        self.adj_list[u].append(v)
        self.adj_list[v].append(u)

    def bfs(self, start):
        visited = set([start])
        queue = deque([start])
        traversal = []

        while queue:
            vertex = queue.popleft()
            traversal.append(vertex)

            for neighbor in self.adj_list.get(vertex, []):
                if neighbor not in visited:
                    visited.add(neighbor)
                    queue.append(neighbor)

        return traversal

    def dfs(self, start, visited=None, traversal=None):
        if visited is None:
            visited = set()
        if traversal is None:
            traversal = []

        visited.add(start)
        traversal.append(start)

        for neighbor in self.adj_list.get(start, []):
            if neighbor not in visited:
                self.dfs(neighbor, visited, traversal)

        return traversal


if __name__ == "__main__":
    g = Graph()
    g.add_edge('A', 'B')
    g.add_edge('A', 'C')
    g.add_edge('B', 'D')
    g.add_edge('B', 'E')
    g.add_edge('C', 'F')
    g.add_edge('E', 'F')

    print("BFS Traversal starting from A:", g.bfs('A'))
    print("DFS Traversal starting from A:", g.dfs('A'))
